<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fairino3mt_v6_robot">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- FR3-C controller FK matches the standard FAIRINO FR3 chain, not the
         fairino3_mt_v6 chain.  fairino3c_v6 is a joint-name-compatible copy
         of fairino3_v6 (joint1..joint6 for the real hardware interface). -->
    <xacro:include filename="$(find fairino_description)/urdf/fairino3c_v6.urdf" />

    <!-- The controller's ToolFlangePose is exactly 100 mm along wrist3 +Z.
         Three live poses agree within 0.004 mm / 0.0005 deg. -->
    <link name="flange_link"/>
    <joint name="wrist3_to_flange" type="fixed">
      <parent link="wrist3_link"/>
      <child link="flange_link"/>
      <origin xyz="0 0 0.1" rpy="0 0 0"/>
    </joint>

    <!-- Gripper mount starts at the controller flange frame. -->
    <xacro:arg name="gripper_mount_xyz" default="0 0 0"/>
    <xacro:arg name="gripper_mount_rpy" default="0 0 0"/>
    <xacro:arg name="gripper_spacer" default="0.003"/>
    <!-- Final practical TCP v2, 2026-09-10.  X/Y come from the 12-pose pivot
         solve; flange-to-tip Z is the user's direct 178 mm measurement.  The
         body-relative Z subtracts the retained 3 mm collision placeholder. -->
    <xacro:arg name="gripper_tcp_from_body_xyz" default="-0.000847397 0.003027928 0.175"/>
    <xacro:arg name="gripper_tcp_rpy" default="0 0 0"/>
    <xacro:arg name="gripper_envelope_x" default="0.180"/>
    <xacro:arg name="gripper_envelope_y" default="0.100"/>
    <xacro:arg name="gripper_envelope_z" default="0.200"/>
    <xacro:include filename="$(find fairino_description)/urdf/ydi_j22_placeholder.xacro"/>
      <xacro:ydi_j22_placeholder parent="flange_link"
        mount_xyz="$(arg gripper_mount_xyz)" mount_rpy="$(arg gripper_mount_rpy)"
        spacer="$(arg gripper_spacer)" tcp_xyz="$(arg gripper_tcp_from_body_xyz)"
        tcp_rpy="$(arg gripper_tcp_rpy)" envelope_x="$(arg gripper_envelope_x)"
        envelope_y="$(arg gripper_envelope_y)" envelope_z="$(arg gripper_envelope_z)"/>

    <!-- Camera housing: 100 x 35 x 20 mm measured by user.
         Centre offset estimated from photos, NOT a hand-eye calibration. -->
    <!-- Nominal flange radius 40 mm + half camera height 17.5 mm. -->
    <xacro:arg name="camera_mount_xyz" default="0 0.0575 0.015"/>
    <xacro:arg name="camera_mount_rpy" default="0 0 0"/>
    <xacro:arg name="camera_size_x" default="0.100"/>
    <xacro:arg name="camera_size_y" default="0.035"/>
    <xacro:arg name="camera_size_z" default="0.020"/>
    <xacro:arg name="camera_collision_padding" default="0.003"/>
    <xacro:include filename="$(find fairino_description)/urdf/gemini_pro_placeholder.xacro"/>
    <xacro:gemini_pro_placeholder parent="gripper_mount_link"
      xyz="$(arg camera_mount_xyz)" rpy="$(arg camera_mount_rpy)"
      size_x="$(arg camera_size_x)" size_y="$(arg camera_size_y)"
      size_z="$(arg camera_size_z)" padding="$(arg camera_collision_padding)"/>

    <!-- Import control_xacro -->
    <xacro:include filename="fairino3mt_v6_robot.ros2_control.xacro" />


    <xacro:fairino3mt_v6_robot_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>

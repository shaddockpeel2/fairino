<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Fixed planning placeholder, NOT a calibrated model of finger deformation.
       Dimensions are metres.  The caller supplies the calibrated TCP separately
       from the approximate visual/collision geometry. -->
  <xacro:macro name="ydi_j22_placeholder" params="parent mount_xyz mount_rpy spacer tcp_xyz tcp_rpy envelope_x envelope_y envelope_z">
    <link name="gripper_mount_link"/>
    <joint name="gripper_mount_joint" type="fixed">
      <parent link="${parent}"/><child link="gripper_mount_link"/>
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
    </joint>
    <link name="gripper_spacer_link">
      <visual><origin xyz="0 0 ${spacer/2}"/><geometry><box size="0.056 0.056 ${spacer}"/></geometry><material name="spacer_gray"><color rgba="0.55 0.55 0.55 1"/></material></visual>
      <collision><origin xyz="0 0 ${spacer/2}"/><geometry><box size="0.056 0.056 ${spacer}"/></geometry></collision>
    </link>
    <joint name="gripper_spacer_joint" type="fixed"><parent link="gripper_mount_link"/><child link="gripper_spacer_link"/></joint>
    <link name="gripper_link">
      <visual><origin xyz="0 0 0.0425"/><geometry><box size="0.056 0.081 0.085"/></geometry><material name="gripper_gray"><color rgba="0.35 0.38 0.42 1"/></material></visual>
      <visual><origin xyz="0.049207 0.021 0.116843" rpy="0 0.65 0"/><geometry><box size="0.012 0.013 0.080"/></geometry><material name="finger_orange"><color rgba="0.85 0.45 0.12 1"/></material></visual>
      <visual><origin xyz="0.049207 -0.021 0.116843" rpy="0 0.65 0"/><geometry><box size="0.012 0.013 0.080"/></geometry><material name="finger_orange"><color rgba="0.85 0.45 0.12 1"/></material></visual>
      <visual><origin xyz="-0.049207 0.021 0.116843" rpy="0 -0.65 0"/><geometry><box size="0.012 0.013 0.080"/></geometry><material name="finger_orange"><color rgba="0.85 0.45 0.12 1"/></material></visual>
      <visual><origin xyz="-0.049207 -0.021 0.116843" rpy="0 -0.65 0"/><geometry><box size="0.012 0.013 0.080"/></geometry><material name="finger_orange"><color rgba="0.85 0.45 0.12 1"/></material></visual>
      <!-- A single conservative placeholder intentionally fills the grasp opening.
           It is for clearance planning, not contact-aware pick/place. -->
      <collision><origin xyz="0 0 ${envelope_z/2}"/><geometry><box size="${envelope_x} ${envelope_y} ${envelope_z}"/></geometry></collision>
    </link>
    <joint name="gripper_joint" type="fixed"><parent link="gripper_spacer_link"/><child link="gripper_link"/><origin xyz="0 0 ${spacer}"/></joint>

    <!-- Calibrated grasp TCP at the common flexible-finger closing tip.
         tcp_xyz is expressed from gripper_link.  The caller compensates the
         placeholder spacer so the complete flange transform remains the
         fixed-point measurement. -->
    <link name="grasp_frame"/>
    <joint name="gripper_to_grasp_frame" type="fixed">
      <parent link="gripper_link"/>
      <child link="grasp_frame"/>
      <origin xyz="${tcp_xyz}" rpy="${tcp_rpy}"/>
    </joint>

    <!-- Command/state-only joint for MoveIt GripperCommand integration.  It
         carries no geometry: the deformable four-finger collision envelope
         remains conservative until measured open/closed meshes are supplied. -->
    <link name="gripper_command_link"/>
    <joint name="gripper_command_joint" type="prismatic">
      <parent link="gripper_link"/>
      <child link="gripper_command_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="0.130" effort="1.0" velocity="0.130"/>
    </joint>
  </xacro:macro>
</robot>

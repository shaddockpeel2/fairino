<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Simplified YDI-J22 model for the first 30 mm cube grasp.

       The calibrated TCP is independent of this approximate geometry. The
       body uses the manufacturer's 56 x 80.59 mm cross-section. Four named
       finger links replace the former solid envelope so the grasp opening is
       real collision-free space and contact permission can be limited to the
       fingers. The finger motion is a planning approximation: all four
       fingers move symmetrically in X from a nominal 29 mm closed opening to
       the drawing's 166 mm maximum span. -->
  <xacro:macro name="ydi_j22_placeholder"
               params="parent mount_xyz mount_rpy spacer tcp_xyz tcp_rpy
                       body_x body_y body_z finger_x finger_y finger_z
                       finger_center_x finger_center_y finger_center_z
                       finger_open_multiplier">
    <link name="gripper_mount_link"/>
    <joint name="gripper_mount_joint" type="fixed">
      <parent link="${parent}"/><child link="gripper_mount_link"/>
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
    </joint>

    <link name="gripper_spacer_link">
      <visual>
        <origin xyz="0 0 ${spacer/2}"/>
        <geometry><box size="0.056 0.056 ${spacer}"/></geometry>
        <material name="spacer_gray"><color rgba="0.55 0.55 0.55 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${spacer/2}"/>
        <geometry><box size="0.056 0.056 ${spacer}"/></geometry>
      </collision>
    </link>
    <joint name="gripper_spacer_joint" type="fixed">
      <parent link="gripper_mount_link"/><child link="gripper_spacer_link"/>
    </joint>

    <!-- Fixed housing/servo region only; it no longer fills the finger opening. -->
    <link name="gripper_link">
      <visual>
        <origin xyz="0 0 ${body_z/2}"/>
        <geometry><box size="${body_x} ${body_y} ${body_z}"/></geometry>
        <material name="gripper_gray"><color rgba="0.35 0.38 0.42 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 ${body_z/2}"/>
        <geometry><box size="${body_x} ${body_y} ${body_z}"/></geometry>
      </collision>
    </link>
    <joint name="gripper_joint" type="fixed">
      <parent link="gripper_spacer_link"/><child link="gripper_link"/>
      <origin xyz="0 0 ${spacer}"/>
    </joint>

    <!-- Single command variable retained for the real GripperCommand driver. -->
    <link name="gripper_command_link"/>
    <joint name="gripper_command_joint" type="prismatic">
      <parent link="gripper_link"/><child link="gripper_command_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="0.130" effort="1.0" velocity="0.130"/>
    </joint>

    <!-- Four independently named contact links. Mimic joints make the two X
         sides move apart symmetrically without adding control variables. -->
    <link name="gripper_finger_px_py_link">
      <visual><geometry><box size="${finger_x} ${finger_y} ${finger_z}"/></geometry><material name="finger_orange"><color rgba="0.85 0.45 0.12 1"/></material></visual>
      <collision><geometry><box size="${finger_x} ${finger_y} ${finger_z}"/></geometry></collision>
    </link>
    <joint name="gripper_finger_px_py_joint" type="prismatic">
      <parent link="gripper_link"/><child link="gripper_finger_px_py_link"/>
      <origin xyz="${finger_center_x} ${finger_center_y} ${finger_center_z}"/>
      <axis xyz="1 0 0"/><limit lower="0" upper="0.057" effort="1" velocity="0.057"/>
      <mimic joint="gripper_command_joint" multiplier="${finger_open_multiplier}"/>
    </joint>

    <link name="gripper_finger_px_ny_link">
      <visual><geometry><box size="${finger_x} ${finger_y} ${finger_z}"/></geometry><material name="finger_orange"/></visual>
      <collision><geometry><box size="${finger_x} ${finger_y} ${finger_z}"/></geometry></collision>
    </link>
    <joint name="gripper_finger_px_ny_joint" type="prismatic">
      <parent link="gripper_link"/><child link="gripper_finger_px_ny_link"/>
      <origin xyz="${finger_center_x} ${-finger_center_y} ${finger_center_z}"/>
      <axis xyz="1 0 0"/><limit lower="0" upper="0.057" effort="1" velocity="0.057"/>
      <mimic joint="gripper_command_joint" multiplier="${finger_open_multiplier}"/>
    </joint>

    <link name="gripper_finger_nx_py_link">
      <visual><geometry><box size="${finger_x} ${finger_y} ${finger_z}"/></geometry><material name="finger_orange"/></visual>
      <collision><geometry><box size="${finger_x} ${finger_y} ${finger_z}"/></geometry></collision>
    </link>
    <joint name="gripper_finger_nx_py_joint" type="prismatic">
      <parent link="gripper_link"/><child link="gripper_finger_nx_py_link"/>
      <origin xyz="${-finger_center_x} ${finger_center_y} ${finger_center_z}"/>
      <axis xyz="-1 0 0"/><limit lower="0" upper="0.057" effort="1" velocity="0.057"/>
      <mimic joint="gripper_command_joint" multiplier="${finger_open_multiplier}"/>
    </joint>

    <link name="gripper_finger_nx_ny_link">
      <visual><geometry><box size="${finger_x} ${finger_y} ${finger_z}"/></geometry><material name="finger_orange"/></visual>
      <collision><geometry><box size="${finger_x} ${finger_y} ${finger_z}"/></geometry></collision>
    </link>
    <joint name="gripper_finger_nx_ny_joint" type="prismatic">
      <parent link="gripper_link"/><child link="gripper_finger_nx_ny_link"/>
      <origin xyz="${-finger_center_x} ${-finger_center_y} ${finger_center_z}"/>
      <axis xyz="-1 0 0"/><limit lower="0" upper="0.057" effort="1" velocity="0.057"/>
      <mimic joint="gripper_command_joint" multiplier="${finger_open_multiplier}"/>
    </joint>

    <!-- Calibrated common fingertip TCP. The parent model supplies the active
         flange-relative value minus its retained 3 mm collision spacer. -->
    <link name="grasp_frame"/>
    <joint name="gripper_to_grasp_frame" type="fixed">
      <parent link="gripper_link"/><child link="grasp_frame"/>
      <origin xyz="${tcp_xyz}" rpy="${tcp_rpy}"/>
    </joint>
  </xacro:macro>
</robot>

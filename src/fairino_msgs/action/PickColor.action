# Execute exactly one color-targeted grasp task.
# pick_hold: grasp and keep holding. pick_sort: grasp and place into the
# configured color region. pick_place: grasp and place into an explicit zone.
# pick_stack: grasp the cube of `color` and stack it on top of the cube of
# `support_color`. Supported color values: red, yellow, blue, green.
string color
# Placement zone for pick_place, resolved against the calibrated A4 grid.
# Use a bare region name such as "A" for the first free slot, or an explicit
# 1-based slot such as "A3". Must stay empty for pick_hold and pick_sort,
# which keep their verified fixed behavior.
string zone
# pick_stack only: the colour of the cube that stays on the table and becomes
# the lower cube of the stack. Must differ from `color`. Every other task must
# leave this empty, exactly like `zone`.
string support_color
# Explicit source location. Empty means the current/start camera view.
# "sort_area" means acquire the source at the calibrated sort-area observation pose.
string source_location
---
uint16 OK=0
uint16 INVALID_COLOR=1
uint16 BUSY=2
uint16 TARGET_NOT_FOUND=3
uint16 TARGET_NOT_UNIQUE=4
uint16 TARGET_STALE=5
uint16 PRECONDITION_FAILED=6
uint16 PLANNING_FAILED=7
uint16 EXECUTION_FAILED=8
uint16 CANCELED=9
uint16 HOLDING_OBJECT=10
uint16 PERCEPTION_UNAVAILABLE=11
uint16 INTERNAL_ERROR=12
uint16 INVALID_ZONE=13
uint16 ZONE_UNAVAILABLE=14
uint16 INVALID_SUPPORT_COLOR=15
uint16 STACK_GEOMETRY_REJECTED=16

bool success
uint16 error_code
string message
string color
# Zone actually used; empty for pick_hold and pick_sort.
string zone
# pick_stack only: the lower cube colour that was actually used.
string support_color
bool executed
---
string phase
string detail
